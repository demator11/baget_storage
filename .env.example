BAGET_ENVIRONMENT=local
BAGET_DATABASE_URL=postgresql+asyncpg://baget:replace-with-local-password@127.0.0.1:5432/baget_storage
BAGET_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BAGET_POSTGRES_PASSWORD=replace-with-local-password
BAGET_ACCESS_TOKEN_MINUTES=60
BAGET_CORS_ORIGINS=[]
BAGET_FRONTEND_BASE_URL=http://localhost:3000
BAGET_REFRESH_TOKEN_DAYS=30
BAGET_EMAIL_VERIFICATION_HOURS=24
BAGET_PASSWORD_RESET_MINUTES=30
BAGET_READING_OPENING_DAY=1
BAGET_READING_DEADLINE_DAY=5
BAGET_SMTP_HOST=mailpit
BAGET_SMTP_PORT=1025
BAGET_SMTP_FROM_ADDRESS=noreply@skladpro.local
BAGET_SMTP_USERNAME=
BAGET_SMTP_PASSWORD=
BAGET_SMTP_STARTTLS=false
BAGET_SMTP_USE_TLS=false
BAGET_SMTP_TIMEOUT_SECONDS=15
BAGET_WORKER_POLL_SECONDS=5
BAGET_WORKER_BATCH_SIZE=20
BAGET_WORKER_MAX_ATTEMPTS=8
